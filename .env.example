# ============================================
# Candidex — Variables d'environnement (TEMPLATE)
# Copiez ce fichier en .env et remplissez les valeurs
# cp .env.example .env
# NE COMMITTEZ JAMAIS le vrai fichier .env
# ============================================

# --- MongoDB ---------------------------------------------------------------
# Compte root (admin) créé au premier démarrage du conteneur
MONGO_INITDB_ROOT_USERNAME=admin
MONGO_INITDB_ROOT_PASSWORD=CHANGE_ME_strong_root_password

# Base de données applicative + utilisateur dédié (non-root)
MONGODB_DATABASE=candidex
MONGODB_APP_USERNAME=candidex_user
MONGODB_APP_PASSWORD=CHANGE_ME_strong_app_password

# Port MongoDB exposé sur l'hôte (optionnel en production)
MONGODB_PORT=27017

# --- Backend (Spring Boot) -------------------------------------------------
# Secret de signature JWT. DOIT faire au moins 32 octets (256 bits).
# Générez-en un avec : openssl rand -base64 48
JWT_SECRET=CHANGE_ME_generate_a_long_random_256_bit_secret
# Durée de vie du token en millisecondes (défaut 24h = 86400000)
JWT_EXPIRATION=86400000

# Origines frontend autorisées (obligatoire en profil prod, séparées par virgule)
CORS_ALLOWED_ORIGINS=http://localhost:8080

# --- Frontend --------------------------------------------------------------
# Port hôte sur lequel l'app Angular (nginx) est servie
FRONTEND_PORT=8080
